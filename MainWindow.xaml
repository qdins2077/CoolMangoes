<Window x:Class="CoolMangoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cool Mangoes LCC Tool" Height="900" Width="1200"
        Background="#F7F7F7">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4ECDC4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="10,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="20"/> 
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selected Corrective Button Style -->
        <Style x:Key="SelectedCorrectiveButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FF6B6B"/>
        </Style>

        <!-- Selected Menu Button Style -->
        <Style x:Key="SelectedActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FF6B6B"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="3" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Header Section -->
        <DockPanel LastChildFill="True" Background="#FF6B6B" Height="70">
            <TextBlock Text="Cool Mangoes" FontSize="36" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </DockPanel>

        <!-- Navigation Menu (Centered) -->
        <DockPanel Grid.Row="1" Background="#4ECDC4" Height="50" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Selected page (Data) with shadow effect -->
                <Button Content="Data" Style="{StaticResource SelectedActionButtonStyle}" Width="120" Click="ShowDataSection"/>
                <!-- LCC Model (Placeholder for future window) -->
                <Button Content="LCC Model" Style="{StaticResource ActionButtonStyle}" Width="120" Click="ShowLCCSection"/>
                <!-- Maintenance Model (Placeholder for future window) -->
                <Button Content="Maintenance Model" Style="{StaticResource ActionButtonStyle}" Width="190" Click="ShowMaintenanceSection"/>
            </StackPanel>
        </DockPanel>

        <!-- Note Section -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="10" HorizontalAlignment="Center">
            <Border Background="#FFD93D" Padding="10" Width="950" CornerRadius="10">
                <TextBlock Text="Please follow the steps in order for the best results!" FontSize="18" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
            </Border>
        </StackPanel>

        <!-- Download and Upload Templates in Two Columns -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"> 
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Download Templates Column -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Text="Download Templates" FontSize="22" FontWeight="Bold" Foreground="#FF6B6B" Margin="10,15,10,5" HorizontalAlignment="Center"/> 
                <Button Content="1. AssetData" Style="{StaticResource ActionButtonStyle}" Click="DownloadAssetData_Click"/>
                <Button Content="3. ClassData" Style="{StaticResource ActionButtonStyle}" Click="DownloadClassData_Click"/>
                <Button Content="5. MaintenanceStrategies" Style="{StaticResource ActionButtonStyle}" Click="DownloadMaintenanceStrategies_Click"/>
                <Button Content="7. MaintenanceProcedures" Style="{StaticResource ActionButtonStyle}" Click="DownloadMaintenanceProcedures_Click"/>
            </StackPanel>

            <!-- Upload Templates Column -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="Upload Data" FontSize="22" FontWeight="Bold" Foreground="#FF6B6B" Margin="10,15,10,5" HorizontalAlignment="Center"/> 
                <Button Content="2. AssetData" Style="{StaticResource ActionButtonStyle}" Click="UploadAssetData_Click"/>
                <Button Content="4. ClassData" Style="{StaticResource ActionButtonStyle}" Click="UploadClassData_Click"/>
                <Button Content="6. MaintenanceStrategies" Style="{StaticResource ActionButtonStyle}" Click="UploadMaintenanceStrategies_Click"/>
                <Button Content="8. MaintenanceProcedures" Style="{StaticResource ActionButtonStyle}" Click="UploadMaintenanceProcedures_Click"/>
            </StackPanel>
        </Grid>

        <!-- Corrective Method Section -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">
            <TextBlock Text="Choose Corrective Method" FontSize="20" FontWeight="Bold" Foreground="#FF6B6B" Margin="10" HorizontalAlignment="Center"/> 
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="Flat (58% PM)" Name="FlatButton" Style="{StaticResource ActionButtonStyle}" Width="150" Click="FlatButton_Click"/>
                <Button Content="Condition Based" Name="ConditionButton" Style="{StaticResource ActionButtonStyle}" Width="150" Click="ConditionButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Project Start and End Dates Section -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20"> 
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Project Start Date -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="5"> 
                    <TextBlock Text="Project Start Date" FontSize="18" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="10"/> 
                    <DatePicker Margin="10" Width="200" Name="StartDatePicker" SelectedDateChanged="ProjectStartDate_SelectedDateChanged"/>
                </StackPanel>

                <!-- Project End Date -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="5"> 
                    <TextBlock Text="Project End Date" FontSize="18" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="10"/> 
                    <DatePicker Margin="10" Width="200" Name="EndDatePicker" SelectedDateChanged="ProjectEndDate_SelectedDateChanged"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- LCC and AMP Models Section -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20"> 
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- LCC Model -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="5"> 
                    <TextBlock Text="1. LCC Model" FontSize="18" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="10"/> 
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <Button Content="Calculate" Style="{StaticResource ActionButtonStyle}" Width="120" Click="CalculateLCCModel_Click"/>
                        <Button Content="Download" Style="{StaticResource ActionButtonStyle}" Width="120" Background="#FF6B6B" Click="DownloadLCCModel_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- AMP Model -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="5"> 
                    <TextBlock Text="2. AMP Model" FontSize="18" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="10"/> 
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <Button Content="Calculate" Style="{StaticResource ActionButtonStyle}" Width="120" Click="CalculateAMPModel_Click"/>
                        <Button Content="Download" Style="{StaticResource ActionButtonStyle}" Width="120" Background="#FF6B6B" Click="DownloadAMPModel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</Window>
