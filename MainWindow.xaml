<Window x:Class="CoolMangoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cool Mangoes v0.01" Height="900" Width="1200"
        Background="#F7F7F7">

    <Window.Resources>
        <!-- Button Styles (unchanged) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4ECDC4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="10,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="20"/> 
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Other Styles (unchanged) -->
        <Style x:Key="SelectedCorrectiveButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FF6B6B"/>
        </Style>

        <Style x:Key="SelectedResetButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FF6B6B"/>
        </Style>

        <Style x:Key="SelectedActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FF6B6B"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="3" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Add the new HelpButtonStyle -->
        <Style x:Key="HelpButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FF6B6B"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE5E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Root Grid with Two Rows -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" /> <!-- Main Content -->
            <RowDefinition Height="Auto" /> <!-- Progress Bar -->
        </Grid.RowDefinitions>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Header Section -->
                <DockPanel LastChildFill="True" Background="#FF6B6B" Height="70">
                    <TextBlock Text="Cool Mangoes" FontSize="36" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </DockPanel>

                <!-- Navigation Menu (Centered) -->
                <DockPanel Grid.Row="1" Background="#4ECDC4" Height="50" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Selected page (Data) with shadow effect -->
                        <Button Content="Data" Style="{StaticResource SelectedActionButtonStyle}" Width="120" Click="ShowDataSection"/>
                        <!-- LCC Model (Placeholder for future window) -->
                        <Button Content="LCC Model" Style="{StaticResource ActionButtonStyle}" Width="120" Click="ShowLCCSection"/>
                        <!-- Maintenance Model (Placeholder for future window) -->
                        <Button Content="Maintenance Model" Style="{StaticResource ActionButtonStyle}" Width="190" Click="ShowMaintenanceSection"/>
                    </StackPanel>
                </DockPanel>

                <!-- Note Section -->
                <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="10" HorizontalAlignment="Center">
                    <Border Background="#FFD93D" Padding="10" Width="950" CornerRadius="10">
                        <TextBlock Text="Please follow the steps in order for the best results!" FontSize="18" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Download and Upload Templates in Three Columns -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"> 
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Download Templates Column -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Download Templates" FontSize="22" FontWeight="Bold" Foreground="#FF6B6B" Margin="10,15,10,5" HorizontalAlignment="Center"/> 
                        <Button Content="1. AssetData" Style="{StaticResource ActionButtonStyle}" Width="250" Click="DownloadAssetData_Click"/>
                        <Button Content="3. ClassData" Style="{StaticResource ActionButtonStyle}" Width="250" Click="DownloadClassData_Click"/>
                        <Button Content="5. MaintenanceStrategies" Style="{StaticResource ActionButtonStyle}" Width="250" Click="DownloadMaintenanceStrategies_Click"/>
                        <Button Content="7. MaintenanceProcedures" Style="{StaticResource ActionButtonStyle}" Width="250" Click="DownloadMaintenanceProcedures_Click"/>
                    </StackPanel>

                    <!-- Upload Templates Column -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Upload Data" FontSize="22" FontWeight="Bold" Foreground="#FF6B6B" Margin="10,15,10,5" HorizontalAlignment="Center"/> 
                        <Button Content="2. AssetData" Style="{StaticResource ActionButtonStyle}" Width="250" Click="UploadAssetData_Click"/>
                        <Button Content="4. ClassData" Style="{StaticResource ActionButtonStyle}" Width="250" Click="UploadClassData_Click"/>
                        <Button Content="6. MaintenanceStrategies" Style="{StaticResource ActionButtonStyle}" Width="250" Click="UploadMaintenanceStrategies_Click"/>
                        <Button Content="8. MaintenanceProcedures" Style="{StaticResource ActionButtonStyle}" Width="250" Click="UploadMaintenanceProcedures_Click"/>
                    </StackPanel>

                    <!-- Add Capital Project Column -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="Add Capital Project" FontSize="22" FontWeight="Bold" Foreground="#FF6B6B" Margin="10,15,10,5" HorizontalAlignment="Center"/> 
                        <Button Content="DownloadTemplate" Style="{StaticResource ActionButtonStyle}" Click="DownladCapital_Click"/>
                        <Button Content="Upload" Style="{StaticResource ActionButtonStyle}" Click="UploadCapital_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Corrective Method and Reset Sections -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Corrective Method Column -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
                            <TextBlock Text="Choose Corrective Method" FontSize="20" FontWeight="Bold" Foreground="#FF6B6B" Margin="10" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                                <Button Content="Flat (58% PM)" Name="FlatButton" Style="{StaticResource ActionButtonStyle}" Width="170" Click="FlatButton_Click"/>
                                <Button Content="Condition Based" Name="ConditionButton" Style="{StaticResource ActionButtonStyle}" Width="170" Click="ConditionButton_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Reset CM at Refurbishment Column -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Reset at Refurbishment" FontSize="20" FontWeight="Bold" Foreground="#FF6B6B" Margin="10"/>
                                <Button Name="HelpButton" 
                                        Style="{StaticResource HelpButtonStyle}" 
                                        VerticalAlignment="Center"
                                        ToolTipService.InitialShowDelay="0"
                                        ToolTipService.ShowDuration="30000">
                                    <Button.Content>
                                        <TextBlock Text="?" FontWeight="Bold"/>
                                    </Button.Content>
                                    <Button.ToolTip>
                                        <ToolTip Background="White" 
                                                BorderBrush="#FF6B6B"
                                                Padding="10">
                                            <TextBlock Text="Remaining Useful Life can be reset to 80% of EstimatedLife at Refurbishment, adjusting CM cost, Likelihood of Failure and Risk calculations"
                                                    TextWrapping="Wrap" 
                                                    MaxWidth="300"
                                                    FontSize="14"/>
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                                <Button Content="Yes" Name="YesButton" Style="{StaticResource ActionButtonStyle}" Width="170" Click="AdjustCorrective_Click" IsEnabled="False"/>
                                <Button Content="No" Name="NoButton" Style="{StaticResource ActionButtonStyle}" Width="170" Click="LeaveCorrective_Click" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Project Start and End Dates Section -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"> 
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Project Start Date -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="5"> 
                            <TextBlock Text="Project Start Date" FontSize="18" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="5"/> 
                            <DatePicker Margin="5" Width="200" Name="StartDatePicker" SelectedDateChanged="ProjectStartDate_SelectedDateChanged"/>
                        </StackPanel>

                        <!-- Project End Date -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="5"> 
                            <TextBlock Text="Project End Date" FontSize="18" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="5"/> 
                            <DatePicker Margin="5" Width="200" Name="EndDatePicker" SelectedDateChanged="ProjectEndDate_SelectedDateChanged"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- LCC and AMP Models Section -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5"> 
                    <Grid>
                    

                        <!-- LCC Model -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="5"> 
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                                <Button Content="Calculate" Style="{StaticResource ActionButtonStyle}" Width="180" Click="CalculateLCCModel_Click"/>
                                <Button Content="Download LCC" Style="{StaticResource ActionButtonStyle}" Width="180" Background="#FF6B6B" Click="DownloadLCCModel_Click"/>
                                <Button Content="Download AMP" Style="{StaticResource ActionButtonStyle}" Width="180" Background="#FF6B6B" Click="DownloadAMPModel_Click"/>
                                <Button Content="PM Schedule" Style="{StaticResource ActionButtonStyle}" Width="180" Background="#FF6B6B" Click="PMSchedule_Click"/>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Progress Bar at the Bottom -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Background="#E0E0E0">
            <TextBlock Text="Wait for confirmation pop ups!" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Foreground="#FF6B6B"
                    FontWeight="Bold"
                    FontSize="16"
                    Margin="0,5,0,5"/>
            <ProgressBar Name="ProgressBar" 
                        Minimum="0" 
                        Maximum="100" 
                        Height="20" 
                        HorizontalAlignment="Stretch" 
                        Margin="0" />
            <TextBlock Name="StatusText" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Margin="0,2,0,2" 
                    FontSize="14" />
        </StackPanel>
    </Grid>
</Window>
